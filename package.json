{
  "name": "postervg",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=8080 --open",
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,scss,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,scss,css}\"",
